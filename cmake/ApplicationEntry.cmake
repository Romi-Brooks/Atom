set(ATOM_WINDOWS_QUIET_RELEASE "$<AND:$<CONFIG:Release,MinSizeRel>,$<NOT:$<STREQUAL:${ATOM_ENABLE_DEBUGGER},ON>>>")

function(atom_use_application_entry target mode)
    if(NOT mode STREQUAL "WINDOWED" AND NOT mode STREQUAL "CONSOLE")
        message(FATAL_ERROR "atom_use_application_entry(${target}) requires WINDOWED or CONSOLE")
    endif()
    if(WIN32 AND mode STREQUAL "WINDOWED")
        set_property(TARGET ${target} PROPERTY WIN32_EXECUTABLE "${ATOM_WINDOWS_QUIET_RELEASE}")
        target_link_libraries(${target} PRIVATE Atom_WindowsDesktopEntry)
    else()
        target_link_libraries(${target} PRIVATE Atom_ApplicationEntry)
    endif()
endfunction()
