@PACKAGE_INIT@

set(Atom_SHARED @ATOM_BUILD_SHARED@)
set_and_check(Atom_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set_and_check(Atom_LIBRARY_DIR "@PACKAGE_CMAKE_INSTALL_LIBDIR@")
set_and_check(Atom_SHADER_DIR "@PACKAGE_atom_sdk_shader_dir@")
include("${CMAKE_CURRENT_LIST_DIR}/AtomTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/AtomHelpers.cmake")

if(Atom_SHARED)
    set(Atom_RUNTIME_DIR "@PACKAGE_CMAKE_INSTALL_BINDIR@")
    if(WIN32)
        set_property(TARGET Atom::Core PROPERTY INTERFACE_SOURCES
            "$<$<STREQUAL:$<TARGET_PROPERTY:TYPE>,EXECUTABLE>:${CMAKE_CURRENT_LIST_DIR}/AtomProcessExit.cpp>")
    endif()
else()
    include("${CMAKE_CURRENT_LIST_DIR}/AtomStaticTargets.cmake")
    if(DEFINED Atom_FOUND AND NOT Atom_FOUND)
        return()
    endif()
endif()
foreach(component IN LISTS Atom_FIND_COMPONENTS)
    if(TARGET Atom::${component})
        set(Atom_${component}_FOUND TRUE)
    endif()
endforeach()
check_required_components(Atom)
