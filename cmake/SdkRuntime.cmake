if(NOT WIN32)
    return()
endif()

set(runtime_files "$<TARGET_FILE:Atom_3rd_SDL3>")
foreach(dll IN LISTS atom_sdk_dlls)
    list(APPEND runtime_files "$<TARGET_FILE:${dll}>")
endforeach()
if(MINGW)
    get_filename_component(compiler_dir "${CMAKE_CXX_COMPILER}" DIRECTORY)
    foreach(runtime IN ITEMS libstdc++-6.dll libgcc_s_seh-1.dll libwinpthread-1.dll)
        execute_process(COMMAND "${CMAKE_CXX_COMPILER}" "-print-file-name=${runtime}"
            OUTPUT_VARIABLE runtime_path OUTPUT_STRIP_TRAILING_WHITESPACE)
        if(NOT IS_ABSOLUTE "${runtime_path}")
            set(runtime_path "${compiler_dir}/${runtime}")
        endif()
        if(NOT EXISTS "${runtime_path}")
            message(FATAL_ERROR "MinGW SDK dependency ${runtime} was not found")
        endif()
        list(APPEND runtime_files "${runtime_path}")
        install(FILES "${runtime_path}" DESTINATION "${CMAKE_INSTALL_BINDIR}")
    endforeach()
elseif(MSVC)
    set(CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS_SKIP TRUE)
    include(InstallRequiredSystemLibraries)
    if(CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS)
        install(FILES ${CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS} DESTINATION "${CMAKE_INSTALL_BINDIR}")
    endif()
endif()

get_property(consumers GLOBAL PROPERTY ATOM_SDK_CONSUMERS)
list(REMOVE_DUPLICATES consumers)
set(output_directories "")
set(runtime_commands "")
foreach(target IN LISTS consumers)
    get_target_property(directory ${target} RUNTIME_OUTPUT_DIRECTORY)
    if(NOT directory)
        get_target_property(directory ${target} BINARY_DIR)
    endif()
    if(NOT directory IN_LIST output_directories)
        list(APPEND output_directories "${directory}")
        list(APPEND runtime_commands
            COMMAND ${CMAKE_COMMAND} -E make_directory "$<TARGET_FILE_DIR:${target}>"
            COMMAND ${CMAKE_COMMAND} -E copy_if_different ${runtime_files} "$<TARGET_FILE_DIR:${target}>")
    endif()
endforeach()
if(consumers)
    add_custom_target(Atom_Sdk_RuntimeFiles ${runtime_commands}
        COMMENT "Staging the Atom SDK runtime beside in-tree applications" VERBATIM)
    add_dependencies(Atom_Sdk_RuntimeFiles ${atom_sdk_dlls})
    foreach(target IN LISTS consumers)
        add_dependencies(${target} Atom_Sdk_RuntimeFiles)
    endforeach()
endif()
