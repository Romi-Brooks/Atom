execute_process(COMMAND "${PROGRAM}" TIMEOUT 12 RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result STREQUAL "0")
    message(FATAL_ERROR "${PROGRAM} failed with ${result}\n${output}\n${error}")
endif()
if(NOT output MATCHES "Atom SDK smoke reached exit")
    message(FATAL_ERROR "${PROGRAM} did not flush its log\n${output}\n${error}")
endif()
if(CHECK_SCREEN AND NOT output MATCHES "Atom SDK released the registered screen")
    message(FATAL_ERROR "${PROGRAM} did not release its screen before logging stopped\n${output}\n${error}")
endif()
