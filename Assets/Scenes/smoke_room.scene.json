// Atom scene, schema_version 1.
// See Docs/Plans/Scene-Schema-v1-CN.md for every field and its validation rule.
//
// This is the scene T2.2 will load; until then Example_2D_Smoke builds the same
// world in code (SeedSmokeScene), which is why the two are kept in step.
//
// Coordinates are world pixels with y pointing DOWN. Rotation is radians, CCW.
{
  "schema_version": 1,
  "id": "smoke_room",
  "name": "Smoke Room",

  "entities": [
    {
      // The eye. Position comes from this entity's transform, never from a
      // separate camera coordinate, so there is exactly one source of truth.
      "id": 1,
      "name": "camera",
      "transform": { "position": [576.0, 624.0] },
      "camera": { "zoom": 1.0, "active": true }
    },

    {
      // The player is drawn last within its layer (highest sort_key) and moved by
      // the FixedUpdate system, so only its authored start position lives here.
      "id": 2,
      "name": "player",
      "tags": ["active"],
      "transform": { "position": [576.0, 624.0] },
      "sprite": {
        "texture": "res://textures/player.png",
        "size": [32.0, 32.0],
        "pivot": [0.5, 0.5],
        "layer": 10,
        "sort_key": 100
      }
    },

    {
      // Two crates with different sort keys: the pair proves the draw order is
      // (layer, sort_key, entity id) and not creation order.
      "id": 3,
      "name": "crate_left",
      "tags": ["static"],
      "transform": { "position": [416.0, 534.0] },
      "sprite": {
        "texture": "res://textures/crate.png",
        "size": [48.0, 48.0],
        "layer": 0,
        "sort_key": 10
      }
    },
    {
      "id": 4,
      "name": "crate_right",
      "tags": ["static"],
      "transform": { "position": [766.0, 684.0] },
      "sprite": {
        "texture": "res://textures/crate.png",
        "size": [48.0, 48.0],
        "layer": 0,
        "sort_key": 20
      }
    },

    {
      // One atlas cell: `source` is a texel rect inside a 16x16 atlas, scaled up
      // to 64x64 on screen. This is the "atlas works" case in the sample.
      "id": 5,
      "name": "atlas_cell",
      "transform": { "position": [276.0, 754.0] },
      "sprite": {
        "texture": "res://textures/atlas.png",
        "source": [8, 0, 8, 8],
        "size": [64.0, 64.0],
        "pivot": [0.5, 0.5],
        "tint": [255, 255, 255, 255],
        "layer": 0,
        "sort_key": 5
      }
    },

    {
      // A sprite that expires on its own: T2.2 loads it, the Lifetime sweep
      // removes it. It exists so the sample covers every v1 field at least once.
      "id": 6,
      "name": "fading_marker",
      "transform": { "position": [876.0, 414.0] },
      "lifetime": 4.0,
      "sprite": {
        "texture": "res://textures/marker.png",
        "size": [32.0, 32.0],
        "pivot": [0.5, 1.0],
        "tint": [255, 200, 200, 255],
        "layer": 5,
        "sort_key": 0,
        "flip_x": true
      }
    }
  ]
}
