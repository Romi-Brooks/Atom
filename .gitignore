# ide build
/cmake-build-*/
/build/
/build-*/

# IDEs
.idea
.workbuddy/

# Office lock files (Excel/Word/PowerPoint owner temp files)
~$*

# forward (temp)
learning-guide

# Runtime logs written by Log::EnableTimestampedFileSink().
# Only the .log files, never the directory: "Log/" is also an engine source
# directory, and ignoring it wholesale would silently drop new engine sources.
/Log/*.log
*.log
