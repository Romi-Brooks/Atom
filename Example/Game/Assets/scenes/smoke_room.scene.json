// Atom scene, schema_version 1.
// See Docs/Plans/Scene-Schema-v1-CN.md for every field and its validation rule.
//
// Loaded by Example_2D_Smoke at boot. Entities 3 and 4 are prefab instances: their
// body lives in res://prefabs/crate.prefab.json and only the overrides differ.
//
// Coordinates are world pixels with y pointing DOWN. Rotation is radians, CCW.
{
  "schema_version": 1,
  "id": "smoke_room",
  "name": "Smoke Room",

  "entities": [
    {
      // The eye. Position comes from this entity's transform, never from a
      // separate camera coordinate, so there is exactly one source of truth.
      "id": 1,
      "name": "camera",
      "transform": { "position": [576.0, 624.0] },
      "camera": { "zoom": 1.0, "active": true }
    },

    {
      // The player is drawn last within its layer (highest sort_key) and moved by
      // the FixedUpdate system, so only its authored start position lives here.
      "id": 2,
      "name": "player",
      "tags": ["active"],
      "transform": { "position": [576.0, 624.0] },
      "sprite": {
        "texture": "res://textures/player.png",
        "size": [32.0, 32.0],
        "pivot": [0.5, 0.5],
        "layer": 10,
        "sort_key": 100
      }
    },

    {
      // Two instances of one prefab. The pair proves three things at once: the base
      // body comes from the prefab file, each instance overrides only the whitelisted
      // fields (position, sort key, name), and different sort keys make the draw order
      // (layer, sort_key, entity id) observable rather than creation order.
      "id": 3,
      "prefab": "res://prefabs/crate.prefab.json",
      "overrides": {
        "name": "crate_left",
        "transform": { "position": [416.0, 534.0] },
        "sprite": { "sort_key": 10 }
      }
    },
    {
      "id": 4,
      "prefab": "res://prefabs/crate.prefab.json",
      "overrides": {
        "name": "crate_right",
        "transform": { "position": [766.0, 684.0] },
        "sprite": { "sort_key": 20 }
      }
    },

    {
      // A named atlas frame. The texel rect, the 64x64 display size and the pivot all
      // come from res://atlases/terrain.atlas.json, and so does `filter: nearest` - so
      // this cell is sampled crisply instead of being smeared by linear filtering.
      // It is also the "source rect without hand-written numbers" case.
      "id": 5,
      "name": "atlas_cell",
      "transform": { "position": [276.0, 754.0] },
      "sprite": {
        "atlas": "res://atlases/terrain.atlas.json",
        "frame": "green",
        "tint": [255, 255, 255, 255],
        "layer": 0,
        "sort_key": 5
      }
    },

    {
      // A sprite that expires on its own: T2.2 loads it, the Lifetime sweep
      // removes it. It exists so the sample covers every v1 field at least once.
      "id": 6,
      "name": "fading_marker",
      "transform": { "position": [876.0, 414.0] },
      "lifetime": 4.0,
      "sprite": {
        "texture": "res://textures/marker.png",
        "size": [32.0, 32.0],
        "pivot": [0.5, 1.0],
        "tint": [255, 200, 200, 255],
        "layer": 5,
        "sort_key": 0,
        "flip_x": true
      }
    }
  ]
}
